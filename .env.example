# Public website — the site builds and runs without any of these set; only
# the /api/contact route (src/app/api/contact/route.ts) needs them, and it
# fails closed (returns a server error to the form, logs the reason) rather
# than crashing the build or the rest of the site if they're missing.
#
# Portal destinations live outside this repository. Until the real URLs are
# confirmed, the header and footer render them as non-interactive placeholders
# rather than dead links.
NEXT_PUBLIC_STUDENT_PORTAL_URL=
NEXT_PUBLIC_ADMIN_PORTAL_URL=

# Contact form email (Resend — https://resend.com). Server-only: never
# exposed to the client, since neither variable is NEXT_PUBLIC_-prefixed and
# both are read only inside the route handler.
#
# RESEND_API_KEY — from the Resend dashboard (Settings -> API Keys). A
# restricted "Sending access" key is enough; this route only sends mail.
#
# RESEND_FROM_EMAIL — the verified sender identity, e.g.
# "SRS Academy <noreply@srstechacademy.com>". Resend requires the domain in
# the address to be verified (Resend dashboard -> Domains -> add
# srstechacademy.com -> add the DNS records it gives you) before it will
# send from that address. Until the domain is verified, Resend's own test
# sender (onboarding@resend.dev) can be used here for a working preview,
# but mail sent that way is more likely to land in spam and should not be
# used for the real production launch.
#
# Both variables must be set on Vercel (Project -> Settings -> Environment
# Variables) for at least the Production environment; add them to Preview
# too if you want contact-form testing to work on PR preview deployments.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Admin panel (/admin). See README "Admin panel".
#
# ADMIN_EMAIL / ADMIN_PASSWORD — the single admin account. The password must
# be at least 6 characters; change it here (Vercel env) and redeploy.
# AUTH_SECRET — 16+ random characters that sign the session cookie, e.g.
# `openssl rand -base64 32`. Changing it signs everyone out.
ADMIN_EMAIL=
ADMIN_PASSWORD=
AUTH_SECRET=

# Private Vercel Blob store for admin data (courses, categories, contact,
# enquiries). Vercel sets this automatically when the store is connected.
# Leave empty locally: the admin then saves to the gitignored .admin-data/.
BLOB_READ_WRITE_TOKEN=
